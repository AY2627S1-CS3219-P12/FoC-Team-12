{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat WebSocket frames - review draft",
  "$defs": {
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "integer"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "title",
        "status"
      ],
      "additionalProperties": false
    },
    "Checkpoint": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "committedSequence": {
          "type": "integer",
          "minimum": 0
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source",
        "stream",
        "aggregateId",
        "committedSequence",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "ProjectionCheckpoint": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "committedSequence": {
          "type": "integer",
          "minimum": 0
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "projectedSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "stream",
        "aggregateId",
        "committedSequence",
        "checkedAt",
        "projectedSequence"
      ],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "fromSequence": {
          "type": "integer",
          "minimum": 0
        },
        "toSequence": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": [
            "MISSING_SEQUENCE",
            "BACKFILL_PENDING",
            "SOURCE_UNAVAILABLE",
            "FAILED_INGESTION"
          ]
        }
      },
      "required": [
        "source",
        "stream",
        "aggregateId",
        "fromSequence",
        "toSequence",
        "reason"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN"
          ]
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectionCheckpoint"
          }
        },
        "blockingGaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          }
        }
      },
      "required": [
        "status",
        "asOf",
        "checkpoints",
        "blockingGaps"
      ],
      "additionalProperties": false
    },
    "Participant": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "relationship": {
          "type": "string",
          "enum": [
            "REQUESTER",
            "HISTORICAL_COURIER"
          ]
        },
        "assignedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "unassignedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "userId",
        "relationship",
        "assignedAt",
        "unassignedAt"
      ],
      "additionalProperties": false
    },
    "OrderSnapshot": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "requesterId": {
          "type": "string",
          "format": "uuid"
        },
        "courierId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING_CREDIT",
            "OPEN",
            "ACCEPTED",
            "PICKED_UP",
            "DELIVERED",
            "COMPLETED",
            "CANCELLED",
            "EXPIRED",
            "RESERVATION_FAILED"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "creditReward": {
          "type": "integer",
          "minimum": 1
        },
        "pickupDeadline": {
          "type": "string",
          "format": "date-time"
        },
        "pickupLocationId": {
          "type": "string",
          "format": "uuid"
        },
        "dropoffLocationId": {
          "type": "string",
          "format": "uuid"
        },
        "pickupLocationName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "dropoffLocationName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "orderId",
        "requesterId",
        "courierId",
        "status",
        "title",
        "description",
        "creditReward",
        "pickupDeadline",
        "pickupLocationId",
        "dropoffLocationId",
        "pickupLocationName",
        "dropoffLocationName"
      ],
      "additionalProperties": false
    },
    "EvidenceData": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ORDER"
            },
            "fromState": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "toState": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "requesterId": {
              "type": "string",
              "format": "uuid"
            },
            "courierId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "previousCourierId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshot": {
              "$ref": "#/$defs/OrderSnapshot"
            }
          },
          "required": [
            "kind",
            "fromState",
            "toState",
            "requesterId",
            "courierId",
            "previousCourierId",
            "snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "CREDIT"
            },
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "ledgerEntries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ledgerEntryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "userId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "availableDelta": {
                    "type": "integer"
                  },
                  "reservedDelta": {
                    "type": "integer"
                  },
                  "availableBalance": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reservedBalance": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "ledgerEntryId",
                  "userId",
                  "availableDelta",
                  "reservedDelta",
                  "availableBalance",
                  "reservedBalance"
                ],
                "additionalProperties": false
              }
            },
            "reasonCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "APPLIED",
                "REJECTED",
                "NO_CHANGE"
              ]
            }
          },
          "required": [
            "kind",
            "operationId",
            "ledgerEntries",
            "reasonCode",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ADMIN"
            },
            "caseId": {
              "type": "string",
              "format": "uuid"
            },
            "operationId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "targetUserId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "APPLIED",
                    "REJECTED",
                    "NO_CHANGE"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "caseId",
            "operationId",
            "targetUserId",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EvidenceRecord": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceSequence": {
          "type": "integer",
          "minimum": 0
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actorUserId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "ingestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "$ref": "#/$defs/EvidenceData"
        }
      },
      "required": [
        "eventId",
        "source",
        "stream",
        "sourceSequence",
        "orderId",
        "action",
        "actorUserId",
        "occurredAt",
        "ingestedAt",
        "data"
      ],
      "additionalProperties": false
    },
    "Eligibility": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "eligible": {
          "type": "boolean"
        },
        "evidenceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "orderId",
        "userId",
        "eligible",
        "evidenceRevision",
        "coverage"
      ],
      "additionalProperties": false
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "format": "uuid"
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "evidenceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "order": {
          "$ref": "#/$defs/OrderSnapshot"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Participant"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "caseId",
        "orderId",
        "evidenceRevision",
        "order",
        "participants",
        "records",
        "coverage",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "EvidenceExport": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "orderId",
        "snapshotId",
        "checkpoint",
        "records",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "AdminEligibility": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "active": {
          "type": "boolean"
        },
        "administrator": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "active",
        "administrator"
      ],
      "additionalProperties": false
    },
    "CaseAccess": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "format": "uuid"
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "UNDER_REVIEW",
            "RESOLVED"
          ]
        },
        "reviewerId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedParticipantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "canReadEvidence": {
          "type": "boolean"
        },
        "canReadConversation": {
          "type": "boolean"
        },
        "canWriteConversation": {
          "type": "boolean"
        }
      },
      "required": [
        "caseId",
        "orderId",
        "state",
        "reviewerId",
        "allowedParticipantIds",
        "canReadEvidence",
        "canReadConversation",
        "canWriteConversation"
      ],
      "additionalProperties": false
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "caseId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "participantUserId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "conversationId",
        "caseId",
        "orderId",
        "participantUserId",
        "readOnly"
      ],
      "additionalProperties": false
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string",
          "format": "uuid"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        }
      },
      "required": [
        "attachmentId",
        "mediaType",
        "sizeBytes"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "senderUserId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attachment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "conversationId",
        "senderUserId",
        "sequence",
        "createdAt",
        "text",
        "attachment"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "attachment": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "text": {
              "type": "null"
            },
            "attachment": {
              "type": "object"
            }
          }
        }
      ]
    },
    "MessagePage": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "content",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "MessageRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "clientMessageId": {
              "type": "string",
              "format": "uuid"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "clientMessageId",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clientMessageId": {
              "type": "string",
              "format": "uuid"
            },
            "attachmentId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "clientMessageId",
            "attachmentId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Translation": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "targetLanguage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "READY",
            "FAILED"
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "messageId",
        "targetLanguage",
        "status",
        "text"
      ],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "ORDER_OPENED",
            "ORDER_RESERVATION_FAILED",
            "ORDER_ACCEPTED",
            "ORDER_COURIER_WITHDREW",
            "ORDER_EXPIRED",
            "ORDER_CANCELLED",
            "ORDER_PICKED_UP",
            "ORDER_DELIVERED",
            "ORDER_COMPLETED",
            "CREDITS_WELCOME",
            "CREDITS_RECEIVED",
            "CREDITS_COMPENSATED"
          ]
        },
        "orderId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "readAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "type",
        "orderId",
        "message",
        "occurredAt",
        "readAt"
      ],
      "additionalProperties": false
    },
    "NotificationPage": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Notification"
          }
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalElements": {
