# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# Base64-encoded PKCS#8 RSA private key used only by User Service.
# Generate it locally or inject it through the deployment secret store.
JWT_PRIVATE_KEY=
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# Supplier Service validates User Service access tokens through its public JWKS.
# The Compose-internal URL is configured in compose.yaml; these are local-run defaults.
SUPPLIER_JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
SUPPLIER_JWT_ISSUER=friend-on-campus-user-service
SUPPLIER_JWT_AUDIENCE=friend-on-campus-api

# Credit Service validates User Service access tokens through its public JWKS.
CREDIT_JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
CREDIT_JWT_ISSUER=friend-on-campus-user-service
CREDIT_JWT_AUDIENCE=friend-on-campus-api

# ---- Supplier Database ----
SUPPLIER_DB_NAME=supplier_db
SUPPLIER_DB_USER=supplier_user
SUPPLIER_DB_PASSWORD=change-me

# ---- User Database ----
USER_DB_NAME=user_db
USER_DB_USER=user_user
USER_DB_PASSWORD=change-me

# ---- Credit Database ------
CREDIT_DB_NAME=credit_db
CREDIT_DB_USER=credit_user
CREDIT_DB_PASSWORD=change-me

# ---- Order Database ------
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change-me

# ---- Chat Database / real-time messaging ----
CHAT_DB_NAME=chat_db
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=change-me-chat-db
CHAT_DB_HOST_PORT=5438
CHAT_HOST_PORT=8085
RABBITMQ_CHAT_USER=chat_service
RABBITMQ_CHAT_PASSWORD=change-me-rabbit-chat
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ---- Notification Database ------
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me

# ---- Credit demo data (optional, local use only) ------------
# Set CREDIT_SPRING_PROFILES_ACTIVE=demo and use the UUID of a registered FoC user.
CREDIT_SPRING_PROFILES_ACTIVE=
CREDIT_DEMO_USER_ID=

# ---- User Email Delivery ----
MAIL_PROVIDER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- First administrator bootstrap (optional, deployment-only) ----
# Set all three only for the first deployment. Store real values in the deployment secret store.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Shared Kafka broker (local Docker Compose only) --------
# SASL/PLAIN passwords are sent without transport encryption in this local setup.
# Use unique local values without quotes/newlines; production must use managed secrets and TLS.
KAFKA_ADMIN_PASSWORD=change-me-kafka-admin
KAFKA_BROKER_PASSWORD=change-me-kafka-broker
KAFKA_USER_SERVICE_PASSWORD=change-me-kafka-user
KAFKA_ORDER_SERVICE_PASSWORD=change-me-kafka-order
KAFKA_CREDIT_SERVICE_PASSWORD=change-me-kafka-credit
KAFKA_CHAT_SERVICE_PASSWORD=change-me-kafka-chat
KAFKA_NOTIFICATION_SERVICE_PASSWORD=change-me-kafka-notification
KAFKA_UI_BROKER_PASSWORD=change-me-kafka-ui-broker
KAFKA_UI_LOGIN_USERNAME=kafka-viewer
KAFKA_UI_LOGIN_PASSWORD=change-me-kafka-ui-login

# Future service adapters use these settings inside Docker. Each container receives its own
# KAFKA_USERNAME and KAFKA_PASSWORD in compose.yaml. Host-side tools use localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN

# ... Add more variables as needed

# Admin runtime (Darryl); review shared activation with all affected owners first.
# Use distinct generated credentials, e.g. openssl rand -hex 32 for broker passwords.
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=replace-with-private-admin-db-password
ADMIN_SERVICE_KEY_ID=admin-service-1
# Base64 PKCS8 DER private key; never commit a real key.
ADMIN_SERVICE_PRIVATE_KEY=
# Preserve any existing service entries; add matching Admin public X509 DER key.
USER_SERVICE_TRUSTED_KEYS={"admin-service-1":{"subject":"admin-service","publicKey":"BASE64_X509_PUBLIC_KEY"}}
# Chat callback identity stays untrusted until Chat supplies its approved public key.
ADMIN_SERVICE_TRUSTED_KEYS={}
KAFKA_ADMIN_SERVICE_PASSWORD=replace-with-random-hex-password
# Optional local host ports; Admin application and database bind to loopback only.
ADMIN_DB_HOST_PORT=5544
ADMIN_HOST_PORT=8084
NOTIFICATION_HOST_PORT=8086
NOTIFICATION_DB_HOST_PORT=5437
GATEWAY_HOST_PORT=8088
KAFKA_HOST_PORT=29092
KAFKA_UI_HOST_PORT=8090

# User-owned sanctions consumer; standalone defaults off, shared Compose defaults on.
USER_ADMIN_COMMANDS_ENABLED=true
